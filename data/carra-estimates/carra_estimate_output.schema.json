{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carra.ai/schemas/repair-estimate-output.schema.json",
  "title": "Carra Repair Estimate Understanding Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parse_metadata",
    "document",
    "shop",
    "vehicle",
    "customer_concern",
    "items",
    "totals",
    "authorization",
    "driver_view",
    "guardrails"
  ],
  "properties": {
    "parse_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "language",
        "currency",
        "overall_confidence",
        "needs_review",
        "review_reasons"
      ],
      "properties": {
        "document_type": {
          "type": "string",
          "enum": [
            "estimate",
            "invoice",
            "repair_order",
            "unknown"
          ]
        },
        "language": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 4217 code, e.g. USD"
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "date",
        "status"
      ],
      "properties": {
        "number": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "description": "YYYY-MM-DD when confidently available"
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "draft",
            "estimate",
            "approved",
            "invoice",
            "paid",
            "unknown",
            null
          ]
        }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "phone"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "make",
        "model",
        "mileage",
        "vin",
        "license_plate"
      ],
      "properties": {
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "make": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "mileage": {
          "type": [
            "integer",
            "null"
          ]
        },
        "vin": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_plate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "customer_concern": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_text",
          "normalized_title",
          "category",
          "status",
          "parts_amount",
          "labor_hours",
          "labor_rate",
          "labor_amount",
          "other_amount",
          "line_total",
          "confidence"
        ],
        "properties": {
          "source_text": {
            "type": "string",
            "description": "Short verbatim document text supporting this line item."
          },
          "normalized_title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "diagnostic",
              "brakes",
              "tires",
              "alignment",
              "maintenance",
              "battery",
              "electrical",
              "engine",
              "ignition",
              "cooling",
              "hvac",
              "suspension",
              "transmission",
              "emissions",
              "body",
              "service_fee",
              "other",
              "high_voltage_battery",
              "charging_system",
              "thermal_management",
              "drive_unit",
              "low_voltage_electrical",
              "regenerative_braking"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "recommended",
              "authorized",
              "approved",
              "declined",
              "performed",
              "pending_diagnosis",
              "additional_authorization_required",
              "unknown"
            ]
          },
          "parts_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "labor_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "labor_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "labor_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "other_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "line_total": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts_subtotal",
        "labor_subtotal",
        "fees",
        "subtotal",
        "tax",
        "total",
        "deposit",
        "balance_due"
      ],
      "properties": {
        "parts_subtotal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "labor_subtotal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "amount"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "subtotal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tax": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "deposit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "balance_due": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_limit",
        "additional_authorization_required",
        "notes"
      ],
      "properties": {
        "authorization_limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "additional_authorization_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "driver_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "summary",
        "item_explanations",
        "questions_to_ask",
        "uncertainties"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "description": "One sentence plain-language headline."
        },
        "summary": {
          "type": "string",
          "description": "2-4 concise sentences explaining what the document says, without diagnosing or overruling the mechanic."
        },
        "item_explanations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_title",
              "plain_language",
              "why_it_matters",
              "amount",
              "source_basis",
              "uncertainty_note"
            ],
            "properties": {
              "item_title": {
                "type": "string"
              },
              "plain_language": {
                "type": "string"
              },
              "why_it_matters": {
                "type": "string",
                "description": "General education only; do not diagnose or declare urgency unless the document explicitly does."
              },
              "amount": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "source_basis": {
                "type": "string",
                "description": "Reference the line item or note that supports the explanation."
              },
              "uncertainty_note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "questions_to_ask": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "reason"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_made",
        "price_fairness_judgment_made",
        "mechanic_overruled",
        "disclaimer"
      ],
      "properties": {
        "diagnosis_made": {
          "type": "boolean",
          "const": false
        },
        "price_fairness_judgment_made": {
          "type": "boolean",
          "const": false
        },
        "mechanic_overruled": {
          "type": "boolean",
          "const": false
        },
        "disclaimer": {
          "type": "string"
        }
      }
    },
    "ev_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "powertrain_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "bev",
            "phev",
            "hybrid",
            "ice",
            "unknown",
            null
          ]
        },
        "high_voltage_system_involved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "charging_system_involved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ev_safety_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}